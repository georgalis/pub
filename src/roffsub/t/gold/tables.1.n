'\" t
.TH TABLES 7 2026-11-15 "roffsub r0.9" "Test Documents"
.SH NAME
tables \- table forms and width fitting
.SH CAP
A short column and two long ones; only the long ones give up width.
.TS
tab(|);
l0 c0 lx0 c0 lx.
abcdef||T{
twelve-chars twelve-chars and more words to thirty
T}||T{
fourteen-chars fourteen-chars more words until the cell reaches fifty
T}
.TE
.SH ALLBOX
.TS
center tab(;);
l0 c0 lx
cb0 c0 cbx
l0 c0 lx
r0 c0 cx
l0 c0 lx
r0 c0 cx
l0 c0 lx
r0 c0 cx
l0 c0 lx.
_;\-+\-;_
NUMBER;;CENTERED
_;\-+\-;_
1;;one
_;\-+\-;_
22;;twenty two
_;\-+\-;_
333;;T{
three hundred thirty three
T}
_;\-+\-;_
.TE
.SH WIDTH
.TS
tab(@);
lw(12)0 c0 lx.
key@@T{
a column with a minimum width of twelve
T}
.TE
.SH RECORDS
.TS
tab(@);
l0 c0 lx0 c0 lx0 c0 l.
supercalifragilistic@@T{
antidisestablishmentarianism
T}@@T{
floccinaucinihilipilification
T}@@pneumonoultramicroscopic
.TE
.SH LITERAL IN A DEFINITION
.TP
\fB\-e\fR \fIexpr\fR
.nf
srt \-e 'one'
srt \-e 'two'
.fi
.TP
.B \-v
verbose.
