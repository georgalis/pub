# roffsub-gen.awk --- embed text (records, pre-formatted text, awk) in C or bash
# roffsub r0.9
# (c) 2026 George Georgalis <george@iuxta.com> Unlimited use with attribution.
#
# usage: awk -v mode=c    -v name=NAME -f roffsub-gen.awk FILE   > NAME.h
#        awk -v mode=bash -v name=NAME -f roffsub-gen.awk FILE   > block
#        awk -v mode=splice -v name=NAME -f roffsub-gen.awk block TARGET > new
#
# c       a NULL-terminated array of strings, one per line
# bash    a marked region reading the text into the variable NAME
# splice  TARGET with its marked region for NAME replaced by block

BEGIN {
	if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) { print "roffsub-gen: bad name: " name > "/dev/stderr"; bad = 1; exit 1 }
	delim = "__ROFFSUB_" name "__"
	begin = "# roffsub " name " begin"
	end = "# roffsub " name " end"
	if (mode == "c") {
		print "/* generated by roffsub-gen.awk; do not edit */"
		print "static const char *const " name "[] = {"
	} else if (mode == "bash") {
		print begin " (generated by roffsub-gen.awk; do not edit)"
		print "IFS= read -r -d '' " name " <<'" delim "' || :"
	} else if (mode != "splice") { print "roffsub-gen: mode is c, bash or splice" > "/dev/stderr"; bad = 1; exit 1 }
}

mode == "c" {
	s = $0
	gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\t/, "\\t", s); gsub(/\?/, "\\?", s)
	print "\t\"" s "\","
	next
}

mode == "bash" {
	if ($0 == delim) { print "roffsub-gen: line equals the delimiter " delim > "/dev/stderr"; bad = 1; exit 1 }
	print
	next
}

mode == "splice" && FNR == NR { blk[++nb] = $0; next }

mode == "splice" {
	if (index($0, begin) == 1) {
		if (done) { print "roffsub-gen: second region for " name > "/dev/stderr"; bad = 1; exit 1 }
		for (i = 1; i <= nb; i++) print blk[i]
		skip = 1; done = 1; next
	}
	if (skip) { if ($0 == end) skip = 0; next }
	print
}

END {
	if (bad) exit 1
	if (mode == "c") { print "\t0"; print "};" }
	else if (mode == "bash") { print delim; print end }
	else if (mode == "splice") {
		if (!done) { print "roffsub-gen: no region for " name > "/dev/stderr"; exit 1 }
		if (skip) { print "roffsub-gen: region for " name " not closed" > "/dev/stderr"; exit 1 }
	}
}
